<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">

	<RelativeLayout
		android:layout_height="wrap_content"
		android:layout_width="match_parent"
		android:padding="12dp">

		<com.google.android.material.button.MaterialButton
			android:layout_height="48dp"
			android:layout_width="48dp"
			app:icon="@android:drawable/ic_menu_preferences"
			android:contentDescription="设置"
			app:iconSize="20dp"
			android:backgroundTint="?attr/colorPrimaryContainer"
			app:iconTint="?attr/colorOnPrimaryContainer"
			style="@style/Widget.Material3.Button.IconButton"
			android:layout_alignParentStart="true"
			android:id="@+id/btn_settings" />

		<TextView
			android:layout_height="wrap_content"
			android:layout_width="wrap_content"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:text="🚧UI界面仍在施工中，所有开关都没用，等待后续更新" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_about"
			style="@style/Widget.Material3.Button.IconButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentEnd="true"
			android:contentDescription="信息"
			app:icon="@android:drawable/ic_menu_info_details" />

	</RelativeLayout>

	<TextView
		android:layout_height="wrap_content"
		android:layout_width="match_parent"
		android:textAppearance="?attr/textAppearanceTitleLarge"
		android:paddingBottom="4dp"
		android:paddingStart="16dp"
		android:paddingTop="8dp"
		android:text="桌宠列表" />

	<com.google.android.material.card.MaterialCardView
		android:layout_height="0dp"
		android:layout_width="match_parent"
		android:layout_marginBottom="12dp"
		android:layout_marginHorizontal="8dp"
		app:cardElevation="0dp"
		app:cardCornerRadius="12dp"
		android:layout_weight="1">

		<ScrollView
			android:layout_height="match_parent"
			android:layout_width="match_parent"
			android:paddingRight="8dp"
			android:paddingLeft="8dp ">

			<LinearLayout
				android:layout_height="wrap_content"
				android:layout_width="match_parent"
				android:orientation="vertical"
				android:paddingTop="10dp">

				<com.google.android.material.card.MaterialCardView
					android:layout_height="wrap_content"
					android:layout_width="match_parent"
					android:layout_marginBottom="12dp"
					android:clickable="true"
					app:cardElevation="2dp"
					app:cardCornerRadius="12dp"
					android:focusable="true">

					<LinearLayout
						android:layout_height="wrap_content"
						android:layout_width="match_parent"
						android:padding="12dp"
						android:orientation="horizontal">

						<ImageView
							android:layout_height="48dp"
							android:layout_width="48dp"
							android:src="@drawable/a"
							android:contentDescription="琪露诺" />

						<LinearLayout
							android:layout_height="wrap_content"
							android:layout_width="0dp"
							android:orientation="vertical"
							android:layout_marginStart="12dp"
							android:layout_weight="1">

							<TextView
								android:layout_height="wrap_content"
								android:layout_width="wrap_content"
								android:textAppearance="?attr/textAppearanceTitleMedium"
								android:text="琪露诺" />

							<TextView
								android:layout_height="wrap_content"
								android:layout_width="wrap_content"
								android:textAppearance="?attr/textAppearanceBodySmall"
								android:textColor="?attr/colorOnSurfaceVariant"
								android:text="笨蛋⑨" />

						</LinearLayout>

						<com.google.android.material.switchmaterial.SwitchMaterial
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:layout_gravity="center_vertical" />

					</LinearLayout>

				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.card.MaterialCardView
					android:layout_height="wrap_content"
					android:layout_width="match_parent"
					android:layout_marginBottom="12dp"
					android:clickable="true"
					app:cardElevation="2dp"
					app:cardCornerRadius="12dp"
					android:focusable="true">

					<LinearLayout
						android:layout_height="wrap_content"
						android:layout_width="match_parent"
						android:padding="12dp"
						android:orientation="horizontal">

						<ImageView
							android:layout_height="48dp"
							android:layout_width="48dp"
							android:src="@drawable/b"
							android:contentDescription="萃香" />

						<LinearLayout
							android:layout_height="wrap_content"
							android:layout_width="0dp"
							android:orientation="vertical"
							android:layout_marginStart="12dp"
							android:layout_weight="1">

							<TextView
								android:layout_height="wrap_content"
								android:layout_width="wrap_content"
								android:textAppearance="?attr/textAppearanceTitleMedium"
								android:text="伊吹萃香" />

							<TextView
								android:layout_height="wrap_content"
								android:layout_width="wrap_content"
								android:textAppearance="?attr/textAppearanceBodySmall"
								android:textColor="?attr/colorOnSurfaceVariant"
								android:text="小小的酒鬼" />

						</LinearLayout>

						<com.google.android.material.switchmaterial.SwitchMaterial
							android:layout_height="wrap_content"
							android:layout_width="wrap_content"
							android:layout_gravity="center_vertical" />

					</LinearLayout>

				</com.google.android.material.card.MaterialCardView>

			</LinearLayout>

		</ScrollView>

	</com.google.android.material.card.MaterialCardView>

	<LinearLayout
		android:layout_height="wrap_content"
		android:layout_width="match_parent"
		android:gravity="center"
		android:padding="12dp"
		android:orientation="horizontal">

		<com.google.android.material.button.MaterialButton
			android:layout_height="wrap_content"
			android:layout_width="0dp"
			android:layout_marginEnd="8dp"
			style="@style/Widget.Material3.Button"
			android:layout_weight="1"
			android:id="@+id/btn_bottom_left"
			android:text="按钮1" />

		<com.google.android.material.button.MaterialButton
			android:layout_height="wrap_content"
			android:layout_width="0dp"
			android:layout_marginEnd="8dp"
			style="@style/Widget.Material3.Button"
			android:layout_weight="1"
			android:id="@+id/btn_bottom_middle"
			android:text="按钮2" />

		<com.google.android.material.button.MaterialButton
			android:layout_height="48dp"
			android:layout_width="48dp"
			app:icon="@drawable/ic_upload_file"
			android:contentDescription="上传"
			app:iconSize="20dp"
			android:backgroundTint="?attr/colorPrimaryContainer"
			app:iconTint="?attr/colorOnPrimaryContainer"
			style="@style/Widget.Material3.Button.IconButton"
			android:layout_alignParentStart="true"
			android:id="@+id/btn_upload_zip" />

	</LinearLayout>

</LinearLayout>